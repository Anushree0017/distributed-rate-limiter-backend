RATE_LIMIT_CONFIG_PATH=config/default_rate_limits.yml
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rate_limiter
RULES_POLL_INTERVAL_SECONDS=60

# HMAC secret used to hash composite identifier values into Redis keys (see
# model/identifier_validation.py / core/key_hasher.py). Required, at least 32
# characters, must be identical across every app instance sharing one Redis —
# changing it resets all live rate-limit counters. Local dev value only;
# never reuse this in a real deployment.
IDENTIFIER_HASH_SECRET=cd8c789ffe831b3531c0012ce263471ac02c41d4caf175a5f123e6984a9189ae

# Phase 6: service auth. Keyring for signing/verifying client-credentials
# JWTs (core/security/tokens.py) — local dev values only, never reuse in a
# real deployment. All instances sharing one issuer must use the same
# keyring.
AUTH_JWT_SIGNING_KEYS={"dev-1": "dev-signing-key-at-least-32-characters-long-aaaa"}
AUTH_JWT_ACTIVE_KID=dev-1
AUTH_JWT_ISSUER=rate-limiter
AUTH_JWT_AUDIENCE=rate-limiter
AUTH_TOKEN_TTL_SECONDS=600
CLIENTS_POLL_INTERVAL_SECONDS=60
